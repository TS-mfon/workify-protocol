{
  "name": "workify-protocol",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @workify/web dev",
    "build": "pnpm --filter @workify/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:contracts": "forge test --root contracts/base",
    "test:genlayer": "genvm-lint check contracts/genlayer/v12/WorkVerifierV12.py && genvm-lint check contracts/genlayer/v1/GenTreasuryV1.py && genvm-lint check contracts/genlayer/v2/GenTreasuryV2.py && uv run --with genlayer-test==0.29.2 pytest tests/direct -q",
    "fixtures:generate": "node scripts/generate-live-fixtures.mjs",
    "deploy:genlayer:v8": "node scripts/deploy-genlayer-v8.mjs",
    "deploy:genlayer:v10": "node apps/web/scripts/deploy-genlayer-v10.mjs",
    "deploy:genlayer:v11": "node apps/web/scripts/deploy-genlayer-v11.mjs",
    "deploy:genlayer:v12": "node apps/web/scripts/deploy-genlayer-v12.mjs",
    "gate:live": "node scripts/run-live-gate.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:contracts && pnpm test:genlayer && pnpm build"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "genlayer-js": "1.1.8",
    "next": "16.3.3",
    "typescript": "5.9.3"
  }
}
